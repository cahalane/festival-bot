data/archive/

# --- Node / TypeScript ---
node_modules/
dist/
*.tsbuildinfo

# --- Runtime caches + state (regenerable) ---
cache/
state/

# --- Lineup fetch sidecars (guarded fetches; inspect then discard) ---
*.fetched.json

# --- App binaries / decompiler artifacts (reverse-eng inputs, not source) ---
*.xapk
*.apk
*.apks

# --- OS / editor noise ---
.DS_Store
*.swp
